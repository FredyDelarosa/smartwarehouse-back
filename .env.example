# ============================================================
# SmartWarehouse - Variables de entorno
# Copia este archivo como .env y ajusta los valores
# ============================================================

# ----- Aplicación -----
APP_NAME=SmartWarehouse API
APP_VERSION=0.1.0
DEBUG=True

# ----- API -----
API_V1_PREFIX=/api/v1

# ----- Base de datos MySQL -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_warehouse
DB_ECHO=False

# ----- JWT -----
SECRET_KEY=cambia-esta-clave-en-produccion-usa-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- CORS (lista separada por comas, sin espacios) -----
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200